@startuml
!define PRIMARY_COLOR #2E86AB
skinparam usecase {
  BackgroundColor White
  BorderColor PRIMARY_COLOR
  ArrowColor PRIMARY_COLOR
}
title Cas d'utilisation — Global

actor Passager
actor Chauffeur

usecase "S'inscrire" as UC_Register
usecase "Se connecter" as UC_Login
usecase "Réserver un trajet" as UC_Book
usecase "Voir prix estimé" as UC_Estimate
usecase "Accepter/Refuser course" as UC_Accept
usecase "Mettre à jour position" as UC_UpdatePos
usecase "Recevoir/Filtrer notifications" as UC_Notif
usecase "Marquer comme lu" as UC_Read

Passager --> UC_Register
Passager --> UC_Login
Passager --> UC_Estimate
Passager --> UC_Book
Passager --> UC_Notif
Passager --> UC_Read
Chauffeur --> UC_Accept
Chauffeur --> UC_UpdatePos

UC_Book .> UC_Estimate : <<include>>
UC_Notif ..> UC_Read : <<extend>>

@enduml
