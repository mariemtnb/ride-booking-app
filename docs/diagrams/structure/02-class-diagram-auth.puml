class User
class AccessToken <<Sanctum>> {
  +id: bigint
  +user_id: bigint
  +name: string
  +token: hash
  +abilities: json
  +created_at: datetime
  +last_used_at: datetime
}

class RegisteredUserController <<Controller>> {
  +store(request)
}
class AuthenticatedSessionController <<Controller>> {
  +store(request)
  +destroy(request)
}

